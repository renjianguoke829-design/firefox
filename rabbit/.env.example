# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:password@localhost:5432/production

# Anthropic Claude API key
ANTHROPIC_API_KEY=your_anthropic_api_key

# Gemini API key and optional model name
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-1.5-pro

# xAI Grok API key and optional model name
GROK_API_KEY=your_grok_api_key
GROK_MODEL=grok-2-latest

# DeepSeek API key and optional model name
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_MODEL=deepseek-chat

# Local Ollama endpoint and model
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=dolphin3-mistral-24b

# Proxy configuration for collectors
PROXY_ENABLED=false
PROXY_HTTP=http://user:pass@host:port
PROXY_SOCKS5=socks5://user:pass@host:port

# Collector platform tokens
HUGGINGFACE_TOKEN=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=production_system/1.0
TWITTER_BEARER_TOKEN=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_CHANNELS=channel1,channel2,channel3
GITHUB_TOKEN=
YOUTUBE_API_KEY=
ARXIV_MAX_RESULTS=50
