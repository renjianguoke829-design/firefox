# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/production
POSTGRES_PASSWORD=your_password_here

# AI API Keys
ANTHROPIC_API_KEY=your_key_here
GEMINI_API_KEY=your_key_here
GROK_API_KEY=your_key_here
DEEPSEEK_API_KEY=your_key_here

# Local model
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=dolphin3-mistral-24b

# Proxy configuration for collectors
PROXY_ENABLED=false
PROXY_HTTP=http://user:pass@host:port
PROXY_SOCKS5=socks5://user:pass@host:port

# Collector platform tokens
HUGGINGFACE_TOKEN=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=production_system/1.0
TWITTER_BEARER_TOKEN=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_CHANNELS=channel1,channel2,channel3
GITHUB_TOKEN=
YOUTUBE_API_KEY=
ARXIV_MAX_RESULTS=50

# Platform switches for pre-production sync
ENABLED_DOMESTIC=weibo,zhihu,bilibili,xiaohongshu,douyin,wechat,qq,douban,hupu,tieba
ENABLED_INTERNATIONAL=telegram,discord,twitter,reddit,youtube,tiktok,instagram,facebook,linkedin,bluesky,mastodon,substack
ENABLED_AI=claude,chatgpt,gemini,grok,deepseek,kimi,wenxin
RCLONE_DB_PATH=/mnt/cloud/raw/pre_production/
